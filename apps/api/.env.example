PORT=3000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://flow:flow_local_only@localhost:5432/flow
DATABASE_POOL_MAX=10
AUTH0_ISSUER=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.flow.local

# Set both IDs from an existing workspace membership for local dashboard access.
LOCAL_DASHBOARD_WORKSPACE_ID=
LOCAL_DASHBOARD_USER_ID=

# Enable database email/password sign-in for members of this workspace.
DATABASE_AUTH_ENABLED=false
PASSWORD_AUTH_WORKSPACE_ID=
